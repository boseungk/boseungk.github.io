{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myanimalroom-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "feedback-api.myanimalroom.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_REAL_PRODUCTION_DATABASE_NAME",
      "database_id": "REPLACE_WITH_REAL_PRODUCTION_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "VISITOR_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "HIT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "HIT_TOTAL_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ]
}
