{
  "name": "myanimalroom-feedback-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8789",
    "db:migrate": "wrangler d1 migrations apply feedback-local --local",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check src/index.js && node --check test/api.test.js",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.151.0"
  },
  "overrides": { "undici": "7.29.1", "sharp": "0.35.5" }
}
