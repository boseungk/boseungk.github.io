// The public site: docs/ (plus the locally built, gitignored docs/assets/live) served as Workers static assets.
// Deploy with services/site/deploy.sh, which stages docs/ into ./dist first. Asset requests never invoke a Worker script,
// so they are free and not counted against the Workers request limit.
// Served through a zone route, not a custom domain: the route acts only while the www DNS record is proxied (orange cloud),
// so switching the proxy off sends www back to GitHub Pages at once.
{
  "$schema": "../feedback/node_modules/wrangler/config-schema.json",
  "name": "myanimalroom-site",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.myanimalroom.com/*", "zone_name": "myanimalroom.com" }],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
